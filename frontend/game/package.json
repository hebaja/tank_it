{
  "name": "tank-it-game",
  "description": "Tank It! game core - Phaser 3 + TypeScript, embedded into the frontend SPA.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
