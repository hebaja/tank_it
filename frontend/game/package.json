    "vite": "^6.3.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "^10.0.11",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "phaser": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "terser": "^5.39.0"
