# Copy to .env and adjust. .env is gitignored — never commit real secrets.

POSTGRES_USER=tankit
POSTGRES_PASSWORD=tankit_dev
POSTGRES_DB=tankit
POSTGRES_PORT=5432

BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# OAuth (Remote Auth buffer module) — fill in once frontend/app registers apps with each provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# JWT signing key for issued access/refresh tokens — generate a real random value, never reuse this
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MINIMUM
