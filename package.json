{
    "name": "tank-it",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "prepare": "husky",
        "lint": "eslint 'frontend/{app,game}/src/**/*.{js,jsx,ts,tsx}' 'frontend/app/vite.config.mjs' 'frontend/game/vite/**/*.mjs' frontend/game/log.js --max-warnings=0",
        "lint:app": "eslint 'frontend/app/src/**/*.{js,jsx,ts,tsx}' frontend/app/vite.config.mjs --max-warnings=0",
        "lint:game": "eslint 'frontend/game/src/**/*.{js,jsx,ts,tsx}' 'frontend/game/vite/**/*.mjs' frontend/game/log.js --max-warnings=0",
        "format": "prettier --write 'frontend/{app,game}/src/**/*.{js,jsx,ts,tsx,css}' 'frontend/{app,game}/index.html' 'frontend/{app,game}/package.json' 'frontend/{app,game}/README.md' 'frontend/app/vite.config.mjs' 'frontend/game/vite/**/*.mjs' 'eslint.config.mjs' '.prettierrc.json' '.github/workflows/ci.yml' 'package.json' 'README.md'",
        "format:check": "prettier --check 'frontend/{app,game}/src/**/*.{js,jsx,ts,tsx,css}' 'frontend/{app,game}/index.html' 'frontend/{app,game}/package.json' 'frontend/{app,game}/README.md' 'frontend/app/vite.config.mjs' 'frontend/game/vite/**/*.mjs' 'eslint.config.mjs' '.prettierrc.json' '.github/workflows/ci.yml' 'package.json' 'README.md'"
    },
    "dependencies": {
        "@microsoft/signalr": "^10.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "eslint": "^10.0.0",
        "globals": "^16.0.0",
        "husky": "^9.0.0",
        "lint-staged": "^16.0.0",
        "prettier": "^3.0.0",
        "typescript-eslint": "^8.0.0",
        "typescript": "~5.7.2"
    },
    "lint-staged": {
        "frontend/{app,game}/src/**/*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "frontend/{app,game}/**/*.{css,html,json,mjs,md}": "prettier --write",
        "*.{json,mjs,yml,yaml,md}": "prettier --write"
    }
}
