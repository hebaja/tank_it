<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- No dotnet SDK was available in the environment that scaffolded this file;
         bump to match whatever LTS SDK the team installs (`dotnet version`). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TankIt.Api</RootNamespace>
    <UserSecretsId>tankit-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Makes EF Core migrations emit snake_case columns/tables, matching db/init/schema.sql
         (idiomatic Postgres naming) instead of the default PascalCase. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

</Project>
